# ============================================================
#  IA SDR - configuracao
#  Copie este arquivo para ".env" e preencha o que for usar.
# ============================================================

# --- Servidor ---
PORT=3000
# Sobe o tunel do Cloudflare junto com o servidor (um comando so).
# Deixe false so se voce tem dominio proprio e preenche PUBLIC_BASE_URL na mao.
TUNEL_AUTOMATICO=true

# --- Onde o banco vive (IMPORTANTE em hospedagem) ---
# O container e descartado a cada deploy. Sem persistencia, some tudo (usuarios,
# dados, sessoes). Duas protecoes:
#
# 1) VOLUME PERSISTENTE (o certo). Na Railway: Settings > Volumes > New Volume,
#    Mount path = /app/data. E confirme DATA_DIR=/app/data nas Variables.
DATA_DIR=
#
# 2) BACKUP REMOTO automatico para um bucket S3/R2 (opcional, e a rede de
#    seguranca). Sobe uma copia a cada X minutos e no encerramento do deploy;
#    se o container subir com o banco vazio, restaura sozinho. Funciona com
#    Cloudflare R2 (tem plano gratis generoso), AWS S3, Backblaze B2, MinIO...
#    R2: endpoint = https://<ACCOUNT_ID>.r2.cloudflarestorage.com , region = auto
BACKUP_S3_ENDPOINT=
BACKUP_S3_BUCKET=
BACKUP_S3_KEY_ID=
BACKUP_S3_SECRET=
BACKUP_S3_REGION=auto
BACKUP_INTERVALO_MIN=30
BACKUP_MANTER=48

# URL publica do servidor (ngrok/cloudflared/servidor). OBRIGATORIA para telefonia real
# e para receber webhooks do WhatsApp. Ex: https://abcd-1234.ngrok-free.app
PUBLIC_BASE_URL=


# --- Contas ---
# Cadastro publico. A primeira conta sempre pode ser criada (vira admin).
# Depois disso, false = so o admin cria usuarios pelo painel.
CADASTRO_ABERTO=false
# Teto de gasto (US$) de quem se cadastrar sozinho. Vazio = sem teto.
LIMITE_PADRAO_USD=

# --- IA (Anthropic) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# --- Prospeccao ---
# Fonte de busca: auto | claude | places
#   claude = so a IA (Claude + web search). NAO precisa de chave do Google.
#   places = Google Places API (New), telefone mais preciso.
#   auto   = usa a IA se houver ANTHROPIC_API_KEY, senao o Google.
PROSPECT_SOURCE=claude

# Opcional: so se quiser usar a fonte "places".
# Console Google Cloud > ative "Places API (New)" > crie uma chave.
GOOGLE_MAPS_API_KEY=

# --- Telefonia: Twilio ---
# Deixe TWILIO_ACCOUNT_SID vazio para rodar em MODO SIMULACAO (sem ligar de verdade).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
# Valida a assinatura dos webhooks da Twilio (recomendado em producao)
TWILIO_VALIDATE_SIGNATURE=false

# Grava a ligacao vencedora (vendedor + empresa) automaticamente. true por padrao.
GRAVAR_LIGACOES=true
# Opcional: Service SID do Twilio Conversational Intelligence, para transcrever
# a gravacao e a IA escrever um resumo breve que vai junto pro CRM. Sem isso,
# a ligacao ainda e gravada (GRAVAR_LIGACOES acima), so nao ha transcricao/resumo.
# Como criar: console.twilio.com > Voice > Intelligence > Create Service
# (idioma pt-BR, nao precisa de nenhum "operator" - o resumo quem escreve e a
# nossa IA, a partir do texto puro que a Twilio devolve). Cole o SID (comeca
# com "GA") aqui.
TWILIO_INTELLIGENCE_SID=

# --- Cobranca: planos (Basic/Pro) e creditos extra via Mercado Pago ---
# Sem essas 3 chaves, a tela de planos fica visivel mas os botoes de assinar/
# comprar credito mostram um aviso de "pagamentos nao configurados" em vez de
# quebrar. Pegue as chaves em mercadopago.com.br/developers > Suas integracoes.
# accessToken e webhookSecret sao SECRETOS (nunca aparecem no navegador).
# publicKey e a UNICA que pode ir para o front-end (tokeniza o cartao).
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_PUBLIC_KEY=
# Console > Sua integracao > Webhooks > "Assinatura secreta" - valida que a
# notificacao realmente veio do Mercado Pago antes de liberar credito.
MERCADOPAGO_WEBHOOK_SECRET=

# Como a ligacao acontece:
#   direto = o vendedor entra na linha PRIMEIRO; o sistema disca para as empresas
#            e a que atender cai direto na ligacao dele. Sem IA falando, sem tecla.
#   ia     = a IA SDR atende, qualifica e so depois transfere para o vendedor.
MODO_LIGACAO=direto
# Segundos esperando o vendedor atender antes de cancelar (nenhuma empresa e chamada).
ESPERA_VENDEDOR=40

# Telefone do vendedor humano que assume a ligacao (E.164). Ex: +5511999999999
HUMAN_AGENT_PHONE=
# Segundos que a IA segura a conversa esperando o humano entrar
HUMAN_HANDOFF_TIMEOUT=45
# Tempo de toque de cada ligacao (segundos)
CALL_RING_TIMEOUT=25
# Voz TTS em pt-BR usada pela IA na ligacao
TTS_VOICE=Polly.Camila-Neural
# Mensagem curta tocada para quem atendeu mas perdeu a corrida
COURTESY_HANGUP_MESSAGE=Desculpe, foi engano. Tenha um otimo dia!

# --- WhatsApp ---
# Provedor: none | meta | evolution | twilio
WHATSAPP_PROVIDER=none
# A IA responder sozinha as mensagens recebidas.
# false = a IA manda so a primeira mensagem para quem nao atendeu; a conversa
#         dai em diante e sua (pelo painel ou pelo proprio WhatsApp).
WHATSAPP_AI_AUTOREPLY=false

# Meta Cloud API (oficial)
META_WA_TOKEN=
META_WA_PHONE_ID=
META_WA_VERIFY_TOKEN=ia-sdr-verify

# Evolution API (nao oficial, self-hosted)
EVOLUTION_BASE_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=

# Twilio WhatsApp (usa as credenciais Twilio acima)
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# --- Protecao do numero de WhatsApp ---
# Disparar tudo de uma vez para desconhecidos e o padrao que derruba numero.
# O sistema enfileira e goteja. Comece conservador e aumente devagar.
WHATSAPP_INTERVALO_MIN=60      # segundos entre uma mensagem e outra (minimo)
WHATSAPP_INTERVALO_MAX=180     # (maximo, sorteado - evita ritmo de robo)
WHATSAPP_LIMITE_DIARIO=40      # teto por dia (numero novo: comece com 15-20)
WHATSAPP_LIMITE_HORA=12        # teto por hora
WHATSAPP_HORA_INICIO=9         # so envia em horario comercial
WHATSAPP_HORA_FIM=19
WHATSAPP_DESCANSO_DIAS=30      # nao repete para o mesmo numero nesse periodo

# --- Economia (opcional) ---
# Modelo por tarefa. Buscar empresas de verdade na web exige o modelo forte;
# conduzir a conversa nao exige - e o leve ainda responde mais rapido no telefone.
#   claude-opus-5 ... US$ 5 / US$ 25 por milhao de tokens (entrada/saida)
#   claude-sonnet-5 . US$ 2 / US$ 10
#   claude-haiku-4-5  US$ 1 / US$ 5
MODELO_BUSCA=claude-sonnet-5
MODELO_AUDITORIA=claude-sonnet-5
MODELO_CONVERSA=claude-haiku-4-5

# Repetir a mesma busca dentro desse prazo reaproveita o resultado (custo zero).
# 0 = sempre buscar de novo.
REAPROVEITAR_BUSCA_DIAS=7

# Procurar o Instagram de quem ficou sem: cada consulta e uma busca web (US$ 0,01).
BUSCAR_INSTAGRAM=true

# Turnos de conversa antes de a IA passar para o humano / encerrar.
# Cada turno custa reconhecimento de voz na Twilio (US$ 0,02).
MAX_TURNOS_IA=4

# --- Empresa / discurso ---
COMPANY_NAME=Minha Empresa
COMPANY_PITCH=Ajudamos empresas do seu segmento a vender mais com automacao de prospeccao.
SDR_AGENT_NAME=Alice
