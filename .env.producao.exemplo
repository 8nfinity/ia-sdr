# ============================================================
#  IA SDR — configuração de PRODUÇÃO (servidor com domínio)
#  Copie para ".env" no servidor e preencha.
#  O que muda em relação ao uso local está marcado com  <<<
# ============================================================

PORT=3000

# <<< Endereço público REAL. Sem túnel: o servidor tem domínio próprio.
PUBLIC_BASE_URL=https://sdr.seudominio.com.br
TUNEL_AUTOMATICO=false

# <<< Onde fica o banco. Precisa ser um disco que NÃO some no deploy.
DATA_DIR=/app/data

# --- Contas ---
# <<< Cadastro aberto = qualquer um que achar a URL cria conta e gasta seu
# crédito de API. Deixe false e crie os usuários pelo painel de administração.
CADASTRO_ABERTO=false
# Teto de gasto (US$) para quem se cadastrar sozinho, se você abrir o cadastro.
LIMITE_PADRAO_USD=5

# --- IA ---
ANTHROPIC_API_KEY=sk-ant-...
MODELO_BUSCA=claude-sonnet-5
MODELO_AUDITORIA=claude-sonnet-5
MODELO_CONVERSA=claude-haiku-4-5
PROSPECT_SOURCE=claude

# --- Telefonia ---
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
TWILIO_PHONE_NUMBER=+1...
HUMAN_AGENT_PHONE=+55...
# <<< Em produção, valide a assinatura dos webhooks da Twilio.
TWILIO_VALIDATE_SIGNATURE=true
MODO_LIGACAO=direto
CALL_RING_TIMEOUT=25
ESPERA_VENDEDOR=40

# --- WhatsApp (opcional) ---
WHATSAPP_PROVIDER=none
WHATSAPP_AI_AUTOREPLY=false

# --- Seu discurso ---
COMPANY_NAME=Sua Empresa
COMPANY_PITCH=Descreva sua oferta em uma frase.
SDR_AGENT_NAME=Alice
